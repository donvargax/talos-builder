# Inherited local-build example. The hosted candidate workflow does not read
# this file, and local image builds are refused outside that workflow.

#5A PSU; PCIe 3.0; RTC Battery Charging
CONFIG_TXT="usb_max_current_enable=1
dtparam=pciex1
dtparam=pciex1_gen=3
dtparam=rtc_bbat_vchg=3000000
"

# No system extensions are selected by default. Add one only through a
# reviewed, pinned input change with a documented need.
EXTENSIONS=""
