From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jorge Vargas <yorch.veintemil+github@gmail.com>
Date: Sun, 18 Oct 2026 03:05:33 -0700
Subject: [PATCH] Patched for Raspberry Pi 5

Build the overlay's Raspberry Pi device trees from the same vendor kernel
commit as the Talos kernel: raspberrypi/linux stable_20260911, commit
cff533aec2fa601846766b32ff57204e0a61bed7 (6.18.50), fetched by commit with
its archive SHA-256/SHA-512.

Skip the overlay's device-tree patches. They adapt vendor device trees to
mainline drivers (RP1 nexus node, RP1 Ethernet, bcm2712 DMA removal and
similar), while this kernel carries the matching vendor drivers.

Drop gpu_mem=32 and hdmi_safe from the Pi 5 config.txt, as the 1.13 builder
did.

Rebased from the "Patched for Raspberry Pi 5" patch of
johnlaur/talos-builder.
---
 Pkgfile                            |  8 ++++----
 artifacts/dtb/raspberrypi/pkg.yaml | 13 ++++++++-----
 installers/rpi_5/src/config.txt    |  6 ------
 3 files changed, 12 insertions(+), 15 deletions(-)

diff --git a/Pkgfile b/Pkgfile
index 5e2c539..ea22f9f 100644
--- a/Pkgfile
+++ b/Pkgfile
@@ -13,10 +13,10 @@ vars:
   uboot_sha256: b60d5865cefdbc75da8da4156c56c458e00de75a49b80c1a2e58a96e30ad0d54
   uboot_sha512: b1f988a497c77da60faf89ed33034e9ae58c4cd7f208e5ce451f1372e13540a66289bee4f08ca2f68f105d73f1ceae058b1f713db549edbcc885d9c66bdc4f8b
 
-  # renovate: datasource=github-tags depName=raspberrypi/linux
-  raspberrypi_kernel_version: stable_20260724
-  raspberrypi_kernel_sha256: ed379d946780441248e5636a41d56fee11161f474025d4216a9fe037daef1b25
-  raspberrypi_kernel_sha512: b70147da8eae0a4f6b2f64ad0fc6ab1dd9a415de944646000defb7e8a418c5cba4d6a0727006721e536f0cd6f3c4959c4d921551b8eed8e3b49aab7f1f186d27
+  # rpi-6.18.y branch, commit cff533aec2fa (2026-09-10), kernel 6.18.50, tag stable_20260911
+  raspberrypi_kernel_version: cff533aec2fa601846766b32ff57204e0a61bed7
+  raspberrypi_kernel_sha256: 6c58de91ade97d7cd9176e408f05c9d134cda64dba95a87b7af976bf26c0c0bd
+  raspberrypi_kernel_sha512: 6f491c45247df1fef7481811c16975fd3ff75d89497e3b748d5f52fa9e28d9cb5d6f10b3ffa30265289d6599ba2d252cd486ca19e1ea94d24291684f6c14aef6
 
   # renovate: datasource=github-tags depName=revolutionpi/linux
   revpi_kernel_version: v6.6.46-rt39-revpi7
diff --git a/artifacts/dtb/raspberrypi/pkg.yaml b/artifacts/dtb/raspberrypi/pkg.yaml
index e64cf3e..b498351 100644
--- a/artifacts/dtb/raspberrypi/pkg.yaml
+++ b/artifacts/dtb/raspberrypi/pkg.yaml
@@ -6,7 +6,7 @@ dependencies:
 steps:
   - network: default
     sources:
-      - url: https://github.com/raspberrypi/linux/archive/refs/tags/{{ .raspberrypi_kernel_version }}.tar.gz
+      - url: https://github.com/raspberrypi/linux/archive/{{ .raspberrypi_kernel_version }}.tar.gz
         destination: raspberrypi-linux.tar.gz
         sha256: "{{ .raspberrypi_kernel_sha256 }}"
         sha512: "{{ .raspberrypi_kernel_sha512 }}"
@@ -15,10 +15,13 @@ steps:
         tar xf raspberrypi-linux.tar.gz --strip-components=1
         rm raspberrypi-linux.tar.gz
 
-        for patch in $(find /pkg/patches -type f -name "*.patch" | sort); do
-          echo "Applying patch $patch"
-          patch -p1 < $patch || (echo "Failed to apply patch $patch" && exit 1)
-        done
+        # These patches adapt vendor device trees to mainline drivers. The
+        # vendor kernel ships the matching vendor drivers, so use its device
+        # trees unmodified.
+        # for patch in $(find /pkg/patches -type f -name "*.patch" | sort); do
+        #   echo "Applying patch $patch"
+        #   patch -p1 < $patch || (echo "Failed to apply patch $patch" && exit 1)
+        # done
 
         mkdir -p arch/arm/boot/dts/overlays/
         cp -av /pkg/overlays/* arch/arm/boot/dts/overlays/
diff --git a/installers/rpi_5/src/config.txt b/installers/rpi_5/src/config.txt
index 9bef001..68d995c 100644
--- a/installers/rpi_5/src/config.txt
+++ b/installers/rpi_5/src/config.txt
@@ -1,10 +1,4 @@
 # See https://www.raspberrypi.com/documentation/computers/configuration.html
-# Reduce GPU memory to give more to CPU.
-gpu_mem=32
-# Enable maximum compatibility on both HDMI ports;
-# only the one closest to the power/USB-C port will work in practice.
-hdmi_safe:0=1
-hdmi_safe:1=1
 # Load U-Boot.
 kernel=u-boot.bin
 # Forces the kernel loading system to assume a 64-bit kernel.
